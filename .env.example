# Puerto de la aplicación
APP_PORT=8000

# URL de pubmed-integration (Quarkus)
PUBMED_INTEGRATION_URL=http://pubmed-integration:8080

# Proveedor de LLM (gemini, deepseek, nvidia, u ollama)
LLM_PROVIDER=gemini

# Configuración NVIDIA NIM
NVIDIA_API_KEY=your_nvapi_key_here
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL_NAME=meta/llama-3.3-70b-instruct

# Configuración DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL_NAME=deepseek-chat

# Configuración Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-1.5-flash

# Configuración Ollama (Para uso futuro o local)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL_NAME=gemma2:9b
